# Porta del server Next.js
PORT=3000

# Token segreto per l'endpoint admin di moderazione commenti.
# Genera un valore lungo e casuale, es: openssl rand -hex 32
ADMIN_TOKEN=cambia-questo-token-segreto

# Chiave d'accesso per gli iscritti Academy: senza di questa il sito mostra
# solo la pagina di accesso. Condividila solo nei canali riservati dell'Academy.
# Genera con: openssl rand -hex 16   (lascia vuota per disattivare il cancello)
SITE_ACCESS_KEY=cambia-questa-chiave-accesso

# Percorso del database SQLite (file)
DATABASE_PATH=./data/hardware-hub.db
